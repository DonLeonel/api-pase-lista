// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Alumnos {
  id          Int           @id @default(autoincrement())
  legajo      String        @db.VarChar(30)
  nombre      String        @db.VarChar(30)
  apellido    String        @db.VarChar(30)
  celular     String        @db.VarChar(30)
  createdAt   DateTime      @default(now()) @db.Timestamp()
  updatedAt   DateTime?     @db.Timestamp()
  deletedAt   DateTime?     @db.Timestamp()
  Asistencias Asistencias[]
  Cursos      Cursos[]
}

model Clases {
  id          Int           @id @default(autoincrement())
  fechaHora   DateTime      @db.Timestamp()
  idMateria   Int
  suspendida  Boolean       @default(false)
  motivo      String? // "Feriado nacional", "Docente ausente", etc.
  createdAt   DateTime      @default(now())
  updatedAt   DateTime?     @db.Timestamp()
  deletedAt   DateTime?     @db.Timestamp()
  materia     Materias      @relation(fields: [idMateria], references: [id])
  Asistencias Asistencias[]
}

model Asistencias {
  id        Int       @id @default(autoincrement())
  idAlumno  Int
  idClase   Int
  estado    Estados   @default(PRESENTE)
  nota      String?   @db.Text
  createdAt DateTime  @default(now()) @db.Timestamp()
  updatedAt DateTime? @db.Timestamp()
  deletedAt DateTime? @db.Timestamp()
  alumno    Alumnos   @relation(fields: [idAlumno], references: [id])
  clase     Clases    @relation(fields: [idClase], references: [id])
}

model UsersDocentes {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  nombre    String     @db.VarChar(30)
  apellido  String     @db.VarChar(30)
  rol       String     @default("DOCENTE") @db.VarChar(15)
  createdAt DateTime   @default(now()) @db.Timestamp()
  updatedAt DateTime?  @db.Timestamp()
  deletedAt DateTime?  @db.Timestamp()
  Materias  Materias[]
}

model Materias {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @db.VarChar(30)
  idUserDocente      Int
  idCurso            Int
  fechaInicio        DateTime             @db.Date
  fechaFin           DateTime             @db.Date
  createdAt          DateTime             @default(now()) @db.Timestamp()
  updatedAt          DateTime?            @db.Timestamp()
  deletedAt          DateTime?            @db.Timestamp()
  userDocente        UsersDocentes        @relation(fields: [idUserDocente], references: [id])
  curso              Cursos               @relation(fields: [idCurso], references: [id])
  Clases             Clases[]
  DiasHorariosClases DiasHorariosClases[]
}

model DiasHorariosClases {
  id              Int       @id @default(autoincrement())
  idMateria       Int
  dias            Dias[]
  horaInicio      String // "08:30"
  duracionMinutos Int // 60
  createdAt       DateTime  @default(now()) @db.Timestamp()
  updatedAt       DateTime? @db.Timestamp()
  deletedAt       DateTime? @db.Timestamp()
  materia         Materias  @relation(fields: [idMateria], references: [id])
}

model Cursos {
  id        Int        @id @default(autoincrement())
  nombre    String     @db.VarChar(50)
  turno     String?    @db.VarChar(10)
  createdAt DateTime   @default(now()) @db.Timestamp()
  updatedAt DateTime?  @db.Timestamp()
  deletedAt DateTime?  @db.Timestamp()
  Materias  Materias[]
  Alumnos   Alumnos[]
}

model FechaNoLectivas {
  id          Int      @id @default(autoincrement())
  fechaInicio DateTime @unique @db.Date()
  fechaFin    DateTime @db.Date()
  motivo      String   @db.VarChar(100)
}

enum Dias {
  LUNES
  MARTES
  MIÉRCOLES
  JUEVES
  VIERNES
  SÁBADO
  DOMINGO
}

enum Estados {
  PRESENTE
  AUSENTE
  JUSTIFICADO
}
